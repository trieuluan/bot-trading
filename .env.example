# Local development only: uncomment to enable hot reload with docker compose up -d.
# COMPOSE_FILE=compose.yaml:compose.dev.yaml
# Production: leave unset or set COMPOSE_FILE=compose.yaml.

POSTGRES_DB=trading
POSTGRES_USER=trading
POSTGRES_PASSWORD=local-development-only
TRADING_MODE=paper
# Password gate for UI/API. Blank = no login (local only). Set it on any server.
APP_PASSWORD=

# Exness Demo connectivity. Put credentials in .env only.
# Private key: secret Ed25519 key from Key Management, not the trading password.
# Discovery host; client resolves the dedicated account host.
EXNESS_API_KEY=
EXNESS_PRIVATE_KEY=
EXNESS_ACCOUNT_ID=
EXNESS_API_BASE_URL=https://api.exness.com
EXNESS_ENVIRONMENT=demo
EXNESS_SYMBOL=XAUUSD
EXNESS_SYMBOLS=XAUUSD,EURUSD,GBPUSD,AUDUSD,NZDUSD,USDJPY,USDCAD,USDCHF,EURJPY,GBPJPY,EURGBP
EXNESS_DATA_ENABLED=false
# Demo-only learning execution. Risk-sized lot, native TP1/TP2; refuses real accounts.
EXNESS_DEMO_EXECUTION_ENABLED=false
# Forex HTF AST V2 entries; also needs the flag above and a tree with 40+ forward samples.
FOREX_HTF_V2_EXECUTION_ENABLED=false
EXNESS_DEMO_MAX_POSITIONS=66
EXNESS_DEMO_MAX_POSITIONS_PER_SYMBOL=6
# Separate slot budget for M1 scalping (not counted in the M15 limit above)
EXNESS_SCALP_MAX_POSITIONS=1
EXNESS_DEMO_MAX_LOT=0.10
EXNESS_DEMO_RISK_PER_TRADE_USD=25
# USD per lot, round turn (entry + exit); demo only, when API omits commission_settings.
# Blank keeps fees unknown; 0 explicitly declares zero commission, not zero spread/swap.
EXNESS_COMMISSION_PER_LOT_USD=

# Optional Telegram alert when the worker stops. Leave blank to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
